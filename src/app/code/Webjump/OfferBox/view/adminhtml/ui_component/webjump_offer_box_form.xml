<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_base_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">webjump_offer_box_form.webjump_offer_box_form_data_source</item>
        </item>
        <item name="label" xsi:type="string">Caixão de Ofertas</item>
    </argument>
    <settings>
        <deps>
            <dep>webjump_offer_box_form.webjump_offer_box_form_data_source</dep>
        </deps>
        <namespace>webjump_offer_box_form</namespace>
    </settings>
    <dataSource name="webjump_offer_box_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="webjump_offer_box_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="20">
        <settings>
            <label>Caixão de Ofertas</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="appearance" formElement="input" sortOrder="0">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">default</item>
                </item>
            </argument>
            <settings>
                <label>Appearance</label>
                <visible>false</visible>
            </settings>
        </field>
        <field name="title" formElement="input" sortOrder="10">
            <settings>
                <label>Título da Oferta</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="desc" formElement="textarea" sortOrder="20">
            <settings>
                <label>Descrição</label>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                </additionalClasses>
            </settings>
        </field>
        <field name="image" formElement="imageUploader" sortOrder="30">
            <settings>
                <label>Imagem</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png svg webp</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="image_size" formElement="select" sortOrder="35">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">large</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label>Tamanho da Imagem</label>
                <dataScope>image_size</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="string">large</item>
                                <item name="label" xsi:type="string">Grande</item>
                            </option>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="string">medium</item>
                                <item name="label" xsi:type="string">Média</item>
                            </option>
                            <option name="2" xsi:type="array">
                                <item name="value" xsi:type="string">small</item>
                                <item name="label" xsi:type="string">Pequena</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
        <urlInput name="link_url" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label>Link da Oferta</label>
                <dataScope>link_url</dataScope>
                <urlTypes class="Magento\Ui\Model\UrlInput\LinksConfigProvider"/>
            </settings>
        </urlInput>
        <field name="button_text" formElement="input" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">Ver Oferta</item>
                </item>
            </argument>
            <settings>
                <label>Texto do Botão</label>
            </settings>
        </field>
        <field name="badge_text" formElement="input" sortOrder="60">
            <settings>
                <label>Selo de Desconto</label>
                <notice>Ex.: -30%, Hoje só, Últimas unidades</notice>
            </settings>
        </field>
    </fieldset>
</form>
