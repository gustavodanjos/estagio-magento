<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Model\Product">
        <plugin name="webjump_gustavo_catalog_product_add_suffix"
                type="Webjump\Gustavo\Plugin\Catalog\Model\AddProductSuffixPlugin"
                sortOrder="10"
                disabled="false"/>
    </type>

    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="webjump_gustavo_add_mensagem_assombrada"
                type="Webjump\Gustavo\Plugin\Checkout\Block\Checkout\AddMensagemAssombradaPlugin"
                sortOrder="10"
                disabled="false"/>
        <plugin name="webjump_gustavo_translate_shipping_step_labels"
                type="Webjump\Gustavo\Plugin\Checkout\Block\Checkout\TranslateShippingStepLabelsPlugin"
                sortOrder="20"
                disabled="false"/>
    </type>

    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="scare-counter" xsi:type="string">Webjump\Gustavo\CustomerData\ScareCounter</item>
            </argument>
        </arguments>
    </type>
</config>
