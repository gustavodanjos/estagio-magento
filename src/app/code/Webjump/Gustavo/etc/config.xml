<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <webjump_gustavo>
            <general>
                <title>Webjump Gustavo - Home Block</title>
                <welcome_message>Bloco renderizado na página inicial utilizando a arquitetura de ViewModels do Magento 2.</welcome_message>
            </general>
            <reviews>
                <enabled>1</enabled>
                <title>Avaliações dos clientes</title>
                <items_per_page>10</items_per_page>
                <default_sort>created_at_desc</default_sort>
            </reviews>
            <halloween_theme>
                <hero_enabled>1</hero_enabled>
                <hero_show_image>1</hero_show_image>
                <hero_opacity>0.85</hero_opacity>
                <hero_show_text>1</hero_show_text>
                <hero_title>Noite Assombrada</hero_title>
                <hero_subtitle>A coleção mais aterrorizante do ano chegou</hero_subtitle>
                <hero_show_button>1</hero_show_button>
                <hero_button_text>Ver Coleção</hero_button_text>
                <hero_button_collection/>
                <hero_button_link>/catalogsearch/result/?q=halloween</hero_button_link>
                <footer_show_image>1</footer_show_image>
                <footer_opacity>0.35</footer_opacity>
                <countdown_enabled>1</countdown_enabled>
            </halloween_theme>
        </webjump_gustavo>
    </default>
</config>
