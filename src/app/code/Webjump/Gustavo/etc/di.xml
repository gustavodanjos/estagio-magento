<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Webjump\Gustavo\Api\Data\ReviewInterface" type="Webjump\Gustavo\Model\Review"/>
    <preference for="Webjump\Gustavo\Api\Data\ReviewSearchResultsInterface" type="Webjump\Gustavo\Model\ReviewSearchResults"/>
    <preference for="Webjump\Gustavo\Api\ReviewRepositoryInterface" type="Webjump\Gustavo\Model\ReviewRepository"/>

    <type name="Magento\Catalog\Block\Product\ListProduct">
        <plugin name="webjump_gustavo_listproduct_template"
                type="Webjump\Gustavo\Plugin\Catalog\Block\Product\ListProductTemplate"
                sortOrder="10"
                disabled="false"/>
    </type>

    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="webjump_gustavo_save_mensagem_assombrada"
                type="Webjump\Gustavo\Plugin\Checkout\Model\SaveMensagemAssombradaPlugin"
                sortOrder="10"
                disabled="false"/>
    </type>

    <type name="Magento\Sales\Model\Service\OrderService">
        <plugin name="webjump_gustavo_copy_mensagem_assombrada"
                type="Webjump\Gustavo\Plugin\Sales\Model\Service\CopyMensagemAssombradaPlugin"
                sortOrder="10"
                disabled="false"/>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="webjump_gustavo_review_listing_data_source" xsi:type="string">Webjump\Gustavo\Model\ResourceModel\Review\Grid\Collection</item>
                <item name="webjump_gustavo_product_listing_data_source" xsi:type="string">Webjump\Gustavo\Model\ResourceModel\Product\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
