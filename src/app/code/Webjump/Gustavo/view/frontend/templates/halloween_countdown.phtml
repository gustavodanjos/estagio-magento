<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Webjump\Gustavo\ViewModel\HalloweenCountdown $viewModel
 */
$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Webjump\Gustavo\ViewModel\HalloweenCountdown || !$viewModel->isEnabled()) {
    return;
}

$countdownConfig = [
    'targetTimestamp' => $viewModel->getTargetTimestamp(),
    'messageTemplate' => $viewModel->getMessageTemplate(),
    'conjunction' => $viewModel->getConjunction(),
    'endedMessage' => $viewModel->getEndedMessage(),
    'unitLabels' => $viewModel->getUnitLabels(),
];
$countdownConfigJson = json_encode(
    $countdownConfig,
    JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
);
?>
<div class="halloween-countdown"
     data-role="halloween-countdown"
     data-bind="scope: 'halloweenCountdown'"
     aria-live="polite">
    <span class="halloween-countdown__message" data-bind="text: message"></span>
</div>
<script type="text/x-magento-init">
{
    "[data-role=halloween-countdown]": {
        "Webjump_Gustavo/js/countdown": <?= /* @noEscape */ $countdownConfigJson ?>
    }
}
</script>
