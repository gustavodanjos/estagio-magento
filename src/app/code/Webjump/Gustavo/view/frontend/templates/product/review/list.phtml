<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Webjump\Gustavo\ViewModel\ProductReviews $viewModel
 */
$viewModel = $block->getData('view_model');
$product = $block->getLayout()->getBlock('product.info')->getProduct();

if (!$viewModel->isEnabled()) {
    return;
}

$reviews = $viewModel->getApprovedReviews((int)$product->getId());
?>
<?php if ($reviews): ?>
    <div class="block webjump-product-reviews">
        <div class="block-title"><strong><?= $block->escapeHtml($viewModel->getTitle()) ?></strong></div>
        <div class="block-content">
            <?php foreach ($reviews as $review): ?>
                <div class="review-item">
                    <div class="review-rating"><?= $block->escapeHtml(__('Nota: %1/5', $review->getRating())) ?></div>
                    <div class="review-content"><?= $block->escapeHtml($review->getComment()) ?></div>
                    <div class="review-author">
                        <?= $block->escapeHtml(
                            __('%1 em %2', $review->getAuthor(), $block->formatDate($review->getCreatedAt()))
                        ) ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>
