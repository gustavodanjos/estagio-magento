<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Webjump_Gustavo::css/home-block.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="webjump.gustavo.home.block"
                   template="Webjump_Gustavo::home_block.phtml"
                   before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Webjump\Gustavo\ViewModel\HomeBlock</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
