<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="webjump-gustavo-category-active"/>
        <referenceBlock name="category.products.list">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Webjump_Gustavo::product/list.phtml</argument>
            </action>
            <block class="Magento\Framework\View\Element\Template"
                   name="selo_sustentavel"
                   template="Webjump_Gustavo::product/badge/selo_sustentavel.phtml" />
        </referenceBlock>
    </body>
</page>
